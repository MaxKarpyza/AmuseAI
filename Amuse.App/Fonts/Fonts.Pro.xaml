<!--
  Icon fonts: Font Awesome 7 PRO - the original Amuse mapping, kept for builds that
  have a commercial licence. Selected with: dotnet build -p:UseFontAwesomePro=true
  after dropping the nine licensed .otf files into Amuse.App/Fonts/.

  Font Awesome Pro is NOT redistributable. The default build uses Fonts.Free.xaml,
  which needs no licence at all. See Fonts/README.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Pro:Classic-->
    <FontFamily x:Key="FontAwesomeBrands">pack://application:,,,/Amuse;component/Fonts/Brands-Regular-400.otf#Font Awesome 7 Brands</FontFamily>
    <FontFamily x:Key="FontAwesomeLight">pack://application:,,,/Amuse;component/Fonts/Light-300.otf#Font Awesome 7 Pro Light</FontFamily>
    <FontFamily x:Key="FontAwesomeRegular">pack://application:,,,/Amuse;component/Fonts/Regular-400.otf#Font Awesome 7 Pro</FontFamily>
    <FontFamily x:Key="FontAwesomeSolid">pack://application:,,,/Amuse;component/Fonts/Solid-900.otf#Font Awesome 7 Pro Solid</FontFamily>
    <FontFamily x:Key="FontAwesomeThin">pack://application:,,,/Amuse;component/Fonts/Thin-100.otf#Font Awesome 7 Pro Thin</FontFamily>

    <!--Pro:Sharp-->
    <FontFamily x:Key="FontAwesomeSharpLight">pack://application:,,,/Amuse;component/Fonts/Sharp-Light-300.otf#Font Awesome 7 Sharp Light</FontFamily>
    <FontFamily x:Key="FontAwesomeSharpRegular">pack://application:,,,/Amuse;component/Fonts/Sharp-Regular-400.otf#Font Awesome 7 Sharp</FontFamily>
    <FontFamily x:Key="FontAwesomeSharpSolid">pack://application:,,,/Amuse;component/Fonts/Sharp-Solid-900.otf#Font Awesome 7 Sharp Solid</FontFamily>
    <FontFamily x:Key="FontAwesomeSharpThin">pack://application:,,,/Amuse;component/Fonts/Sharp-Thin-100.otf#Font Awesome 7 Sharp Thin</FontFamily>

</ResourceDictionary>
